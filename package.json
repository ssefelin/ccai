{
  "name": "agent-web-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts --production"
  },
  "dependencies": { "express": "^5.1.0", "openai": "^6.0.0" },
  "devDependencies": { "@types/express": "^5.0.0", "@types/node": "^24.0.0", "typescript": "^5.9.0", "vite": "^7.1.0" },
  "engines": { "node": ">=24" }
}
